    cxx.find_library('LLVMMCParser', required: true, dirs: meson.current_source_dir() / get_option('buildtype') / 'lib'),
    cxx.find_library('LLVMObject', required: true, dirs: meson.current_source_dir() / get_option('buildtype') / 'lib'),
    cxx.find_library('LLVMObjectYAML', required: true, dirs: meson.current_source_dir() / get_option('buildtype') / 'lib'),
    cxx.find_library('LLVMOption', required: true, dirs: meson.current_source_dir() / get_option('buildtype') / 'lib'),
