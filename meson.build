    cxx.find_library('LLVMDWARFCFIChecker', required: true, dirs: meson.current_source_dir() / get_option('buildtype') / 'lib'),
    cxx.find_library('LLVMFrontendAtomic', required: true, dirs: meson.current_source_dir() / get_option('buildtype') / 'lib'),
    cxx.find_library('LLVMFrontendDirective', required: true, dirs: meson.current_source_dir() / get_option('buildtype') / 'lib'),
    cxx.find_library('LLVMFrontendDriver', required: true, dirs: meson.current_source_dir() / get_option('buildtype') / 'lib'),
    cxx.find_library('LLVMFrontendHLSL', required: true, dirs: meson.current_source_dir() / get_option('buildtype') / 'lib'),
    cxx.find_library('LLVMFrontendOffloading', required: true, dirs: meson.current_source_dir() / get_option('buildtype') / 'lib'),
