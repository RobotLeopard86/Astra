    cxx.find_library('LLVMTextAPI', required: true, dirs: meson.current_source_dir() / get_option('buildtype') / 'lib'),
    cxx.find_library('LLVMTransformUtils', required: true, dirs: meson.current_source_dir() / get_option('buildtype') / 'lib'),
