project('llvm', 'c', 'cpp', version: '22.1.7', license: 'Apache-2.0 WITH LLVM-exception')

if host_machine.system() != 'windows'
    error('Cannot use Windows LLVM binaries on other OS!')
endif

cxx = meson.get_compiler('cpp')
llvm_dep = declare_dependency(include_directories: get_option('buildtype') / 'include', dependencies: [
    cxx.find_library('LLVMAnalysis', required: true, dirs: meson.current_source_dir() / get_option('buildtype') / 'lib'),
    cxx.find_library('LLVMAsmParser', required: true, dirs: meson.current_source_dir() / get_option('buildtype') / 'lib'),
    cxx.find_library('LLVMBinaryFormat', required: true, dirs: meson.current_source_dir() / get_option('buildtype') / 'lib'),
    cxx.find_library('LLVMBitReader', required: true, dirs: meson.current_source_dir() / get_option('buildtype') / 'lib'),
    cxx.find_library('LLVMBitstreamReader', required: true, dirs: meson.current_source_dir() / get_option('buildtype') / 'lib'),
    cxx.find_library('LLVMCore', required: true, dirs: meson.current_source_dir() / get_option('buildtype') / 'lib'),
    cxx.find_library('LLVMDebugInfoCodeView', required: true, dirs: meson.current_source_dir() / get_option('buildtype') / 'lib'),
    cxx.find_library('LLVMDebugInfoDWARF', required: true, dirs: meson.current_source_dir() / get_option('buildtype') / 'lib'),
    cxx.find_library('LLVMDebugInfoDWARFLowLevel', required: true, dirs: meson.current_source_dir() / get_option('buildtype') / 'lib'),
    cxx.find_library('LLVMDebugInfoPDB', required: true, dirs: meson.current_source_dir() / get_option('buildtype') / 'lib'),
